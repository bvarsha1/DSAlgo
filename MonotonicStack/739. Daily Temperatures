/*
739. Daily Temperatures
https://leetcode.com/problems/daily-temperatures/description/
*/

class Solution {
    public int[] dailyTemperatures(int[] temps) {
        int n = temps.length;
        Stack<Integer> stack = new Stack();
        int[] ans = new int[n];
        Arrays.fill(ans, 0);

        for(int i = 0; i < n; i++) {
            while(!stack.isEmpty() && temps[stack.peek()] < temps[i]) {
                int idx = stack.pop();
                ans[idx] = i - idx;
            }
            stack.push(i);
        }
        return ans;
    }
}