/*
1856. Maximum Subarray Min-Product
https://leetcode.com/problems/maximum-subarray-min-product/description/
*/

class Solution {
    public int maxSumMinProduct(int[] nums) {
        long MOD = (long) 1e9 + 7;
        Stack<int[]> stack = new Stack();
        long ans = 0;
        long[] prefix = new long[nums.length + 1];
        prefix[0] = 0;
        for(int i = 0; i < nums.length; i++) {
            prefix[i + 1] = prefix[i] + nums[i];
        }

        for(int i = 0; i < nums.length; i++) {
            int start = i;
            while(!stack.isEmpty() && stack.peek()[1] > nums[i]) {
                int[] pop = stack.pop();
                start = pop[0];
                // not including the incoming number
                long sum = prefix[i] - prefix[start];
                ans = Math.max(ans, sum * pop[1]);
            }
            stack.push(new int[] { start, nums[i] });
        }

        while(!stack.isEmpty()) {
            int[] pop = stack.pop();
            int start = pop[0];
            long sum = prefix[nums.length] - prefix[start];
            ans = Math.max(ans, sum * pop[1]);
        }

        return (int) (ans % MOD);
    }
}